rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /profile_photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /ride_reports_attachments/{reportId}/{fileName} {
      allow read, write: if isSignedIn();
    }

    match /user_qr_codes/{userId}/{fileName} {
      allow read, write: if isOwner(userId);
    }

    match /verification_docs/{userId}/{fileName} {
      allow read, write: if isOwner(userId);
    }

    match /matric_cards/{userId}/{fileName} {
      allow read, write: if isOwner(userId);
    }

    match /delivery_item_photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /delivery_proofs/{jobId}/{fileName} {
      allow read, write: if isSignedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}