
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    function requestDoc(requestId) {
      return get(/databases/$(database)/documents/carpool_requests/$(requestId));
    }

    function groupDoc(requestId) {
      return get(/databases/$(database)/documents/carpool_groups/$(requestId));
    }

    function isGroupMember(requestId) {
      return exists(/databases/$(database)/documents/carpool_groups/$(requestId))
        && groupDoc(requestId).data.member_ids.hasAny([request.auth.uid]);
    }

    function deliveryJobDoc(jobId) {
      return get(/databases/$(database)/documents/delivery_jobs/$(jobId));
    }

    match /users/{userId} {
      // App flows need user profile reads (self and peers) plus self profile writes.
      // Admin keeps full access for moderation dashboards.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Bank/QR payment details. Owner-only — never read directly by other
    // users. Payers see a snapshot copied onto the payment doc instead
    // (see ride_payments / delivery_payments + the copyPayeeBankDetails
    // Cloud Function).
    match /bank_details/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /driverApplications/{applicationId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /carpool_requests/{requestId} {
      allow read: if isSignedIn()
        && (
          resource.data.status == 'open'
          || resource.data.creator_id == request.auth.uid
          || isGroupMember(requestId)
        );
      allow create: if isSignedIn() && request.resource.data.creator_id == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.creator_id == request.auth.uid ||
        resource.data.status == 'open' ||
        isGroupMember(requestId)
      );
      allow delete: if isSignedIn() && resource.data.creator_id == request.auth.uid;
    }

    match /carpool_applicants/{applicantId} {
      allow read: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        requestDoc(resource.data.request_id).data.creator_id == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (
        requestDoc(resource.data.request_id).data.creator_id == request.auth.uid ||
        resource.data.user_id == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        requestDoc(resource.data.request_id).data.creator_id == request.auth.uid
      );
    }

    match /carpool_groups/{requestId} {
      allow create: if isSignedIn() && request.resource.data.admin_id == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.member_ids.hasAny([request.auth.uid])
        || requestDoc(requestId).data.creator_id == request.auth.uid
        || requestDoc(requestId).data.status == 'open'
      );
      allow update: if isSignedIn() && (
        resource.data.admin_id == request.auth.uid ||
        requestDoc(requestId).data.status == 'open' ||
        resource.data.member_ids.hasAny([request.auth.uid])
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && groupDoc(requestId).data.member_ids.hasAny([request.auth.uid]);
        allow update, delete: if false;
      }
    }

    match /ride_payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        requestDoc(request.resource.data.request_id).data.creator_id == request.auth.uid ||
        groupDoc(request.resource.data.request_id).data.driver_id == request.auth.uid
      );
      allow update: if isSignedIn() && (
        requestDoc(resource.data.request_id).data.creator_id == request.auth.uid ||
        groupDoc(resource.data.request_id).data.driver_id == request.auth.uid ||
        (
          groupDoc(resource.data.request_id).data.member_ids.hasAny([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed_by']) &&
          request.resource.data.confirmed_by.hasAll(resource.data.confirmed_by) &&
          request.resource.data.confirmed_by.hasAny([request.auth.uid])
        )
      );
      allow delete: if false;
    }

    match /ride_reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.reported_by == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /delivery_jobs/{jobId} {
      // Anyone signed in can browse/read open jobs. Writes are scoped to
      // the seller (job owner) or the assigned driver — not "anyone".
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.seller_id == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.seller_id == request.auth.uid ||
        resource.data.assigned_driver_id == request.auth.uid
      ) &&
        // Job cannot be marked completed while a dispute is open — this
        // mirrors the check in delivery_service.dart's completeJob(), but
        // THIS is the one that's actually enforced; the client-side check
        // is just a nicer error message before the request round-trips.
        !(
          request.resource.data.job_status == 'completed' &&
          resource.data.job_status == 'disputed'
        );
      allow delete: if isAdmin() || resource.data.seller_id == request.auth.uid;

      match /applications/{applicationId} {
        allow read, create, update: if isSignedIn();
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }

      match /proofs/{proofId} {
        allow read, create, update: if isSignedIn();
        allow delete: if false;
      }
    }

    match /delivery_payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        deliveryJobDoc(request.resource.data.job_id).data.seller_id == request.auth.uid
      );
      allow update: if isSignedIn() && (
        deliveryJobDoc(resource.data.job_id).data.seller_id == request.auth.uid ||
        (
          deliveryJobDoc(resource.data.job_id).data.assigned_driver_id == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driver_confirmed_at']) &&
          resource.data.status == 'settled' &&
          resource.data.payment_proof_url is string &&
          resource.data.payment_proof_url.size() > 0
        )
      );
      allow delete: if false;
    }

    match /delivery_disputes/{disputeId} {
      // Either party to the job can read disputes on it, and either can
      // file one (create). Only an admin can move it to resolved.
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.seller_id == request.auth.uid ||
        resource.data.driver_id == request.auth.uid ||
        resource.data.filed_by == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.seller_id == request.auth.uid ||
        request.resource.data.driver_id == request.auth.uid
      ) && request.resource.data.filed_by == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}

